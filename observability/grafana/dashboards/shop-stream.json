{
  "uid": "shop-stream",
  "title": "shop-stream",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "tags": ["shop-stream"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput in vs processed",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {
          "refId": "A",
          "expr": "shop_spark_input_rows_per_second",
          "legendFormat": "{{query}} in"
        },
        {
          "refId": "B",
          "expr": "shop_spark_processed_rows_per_second",
          "legendFormat": "{{query}} processed"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Generator produced / sec",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(shop_generator_events_total[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Spark checkpoint lag",
      "description": "Kafka end offset minus the checkpoint resume offset. This moves while the driver is stopped, because Structured Streaming does not commit a consumer group.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (query) (shop_spark_checkpoint_lag_records)",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Batch duration",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [
        {
          "refId": "A",
          "expr": "shop_spark_batch_duration_ms",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rows dropped by watermark",
      "description": "Late events removed from session and GMV state. Fact tables still keep those payments.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (query) (increase(shop_spark_watermark_dropped_total[5m]))",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "State rows",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "shop_spark_state_rows",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DLQ by category",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_class) (rate(shop_dlq_events_total[1m]))",
          "legendFormat": "{{error_class}}"
        }
      ]
    }
  ]
}
