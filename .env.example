# Copy to .env if you want to override the defaults baked into docker-compose.yml.
# `make up` copies this file when .env is missing.
# Nothing here is a real secret. The database has no auth beyond this local password.

# --- generator ---
# Events produced per second. Floats are fine (0.5 = one event every 2s).
EVENTS_PER_SECOND=5
# Optional integer seed for the session simulator. Empty = nondeterministic.
SIM_SEED=

# --- kafka (compose network, not the host port) ---
# Host tools (kcat, Kafka UI in a browser) use localhost:9092.
# Containers must use the internal listener.
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
TOPIC=shop.events
TOPIC_PARTITIONS=3
# 24h. The broker is one node; this is a disk cap, not a durability setting.
TOPIC_RETENTION_MS=86400000

SCHEMA_REGISTRY_URL=http://schema-registry:8081

# --- postgres ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# --- mongo ---
# retryWrites=false is required: this is a standalone mongod, not a replica set.
MONGO_URI=mongodb://mongo:27017/?retryWrites=false
MONGO_DB=shop

# --- spark ---
CHECKPOINT_DIR=/checkpoints/shop-events
TRIGGER_INTERVAL=5 seconds
MAX_OFFSETS_PER_TRIGGER=500

# --- published host ports ---
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
POSTGRES_PORT=5432
MONGO_PORT=27017
KAFKA_UI_PORT=8080
SPARK_UI_PORT=4040
