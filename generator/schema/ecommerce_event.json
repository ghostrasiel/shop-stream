{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EcommerceEvent",
  "description": "One shop event. payload fields depend on event_type: page (page_view, add_to_cart), product (add_to_cart), order (order_created), payment (payment_completed). device is always set. utm is omitted for direct traffic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_time", "user_id", "session_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {
      "type": "string",
      "enum": ["page_view", "add_to_cart", "order_created", "payment_completed"]
    },
    "event_time": {
      "type": "string",
      "minLength": 20,
      "description": "ISO-8601 UTC, e.g. 2026-11-12T17:04:05.123Z"
    },
    "user_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "payload": {"$ref": "#/definitions/payload"}
  },
  "definitions": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device"],
      "properties": {
        "device": {"$ref": "#/definitions/device"},
        "utm": {"$ref": "#/definitions/utm"},
        "page": {"$ref": "#/definitions/page"},
        "product": {"$ref": "#/definitions/lineItem"},
        "order": {"$ref": "#/definitions/order"},
        "payment": {"$ref": "#/definitions/payment"}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "os", "app_version"],
      "properties": {
        "type": {"type": "string", "enum": ["mobile", "desktop"]},
        "os": {"type": "string", "minLength": 1},
        "app_version": {"type": "string", "minLength": 1}
      }
    },
    "utm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "medium", "campaign"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "campaign": {"type": "string", "minLength": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "referrer": {"type": "string", "minLength": 1}
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "name", "category", "qty", "unit_price"],
      "properties": {
        "sku": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "qty": {"type": "integer", "minimum": 1},
        "unit_price": {"type": "number", "minimum": 0}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "currency", "items", "total_amount"],
      "properties": {
        "order_id": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 3, "maxLength": 3},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/lineItem"}
        },
        "total_amount": {"type": "number", "minimum": 0}
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_id", "order_id", "amount", "method", "status"],
      "properties": {
        "payment_id": {"type": "string", "minLength": 1},
        "order_id": {"type": "string", "minLength": 1},
        "amount": {"type": "number", "minimum": 0},
        "method": {"type": "string", "enum": ["card", "paypal", "apple_pay"]},
        "status": {"type": "string", "enum": ["captured"]}
      }
    }
  }
}
